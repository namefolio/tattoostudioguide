{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tattoostudioguide",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page",
    // The Worker runs only for the form and the Verified thanks page; everything else is static.
    "run_worker_first": ["/add-your-business/", "/add-your-business/thanks-verified/"]
  },
  // Email Routing must be enabled on the domain and the destination verified.
  "send_email": [{ "name": "SUBMISSIONS", "destination_address": "PLACEHOLDER-submissions@example.com" }],
  "vars": {
    "SUBMISSIONS_TO": "PLACEHOLDER-submissions@example.com",
    "FORM_FROM": "forms@tattoostudioguide.com",
    "TURNSTILE_SITE_KEY": ""
  }
  // Secret: TURNSTILE_SECRET (wrangler secret put TURNSTILE_SECRET). Local dev uses .dev.vars with test keys.
}
