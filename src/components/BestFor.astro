---
import { site } from '../../site.config';
import type { Listing } from '../lib/types';
interface Props { listings: Listing[]; place: string }
const { listings, place } = Astro.props;
const groups = site.bestFor.map((b) => ({ label: b.label, items: listings.filter(b.test) })).filter((g) => g.items.length > 0);
---
{groups.length > 0 && (
  <section class="section" aria-labelledby="best-for">
    <div class="section-head">
      <div>
        <h2 id="best-for">Good to know in {place}</h2>
      </div>
      <p>Built from what each {site.entity.one} publishes. Not a ranking.</p>
    </div>
    <div class="cols">
      {groups.map((g) => (
        <div>
          <h3>{g.label}</h3>
          <ul>{g.items.map((l) => <li><a href={l.url}>{l.name}</a></li>)}</ul>
        </div>
      ))}
    </div>
  </section>
)}
