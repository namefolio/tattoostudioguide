---
import type { Faq } from '../lib/types';
interface Props { faqs: Faq[]; heading?: string; id?: string; class?: string }
const { faqs, heading = 'Questions', id = 'faqs', class: cls } = Astro.props;
---
{faqs.length > 0 && (
  <section class={cls} aria-labelledby={id}>
    <h2 id={id}>{heading}</h2>
    <div class="faq">
      {faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
    </div>
  </section>
)}
