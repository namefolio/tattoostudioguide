---
import ListingCard from './ListingCard.astro';
import { disclosure, disclosureLinkText } from '../lib/copy';
import type { Listing } from '../lib/types';
interface Props { listings: Listing[]; showCity?: boolean }
const { listings, showCity } = Astro.props;
---
<p class="disclosure">{disclosure} <a href="/listing-plans/">{disclosureLinkText}</a></p>
<ul class="grid">
  {listings.map((l) => <ListingCard listing={l} showCity={showCity} />)}
</ul>
