---
// Small inline icons. Always decorative: the text beside them carries the meaning.
interface Props { name: 'check' | 'search' | 'arrow' | 'pin'; class?: string }
const { name, class: cls } = Astro.props;
---
{name === 'check' && <svg class={cls} viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M3 8.5l3.2 3L13 4.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" /></svg>}
{name === 'search' && <svg class={cls} viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="6" fill="none" stroke="currentColor" stroke-width="1.8" /><path d="M13 13l5 5" stroke="currentColor" stroke-width="1.8" /></svg>}
{name === 'arrow' && <svg class={cls} viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3 10h13M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>}
{name === 'pin' && <svg class={cls} viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 18s6-5.6 6-10A6 6 0 0 0 4 8c0 4.4 6 10 6 10z" fill="none" stroke="currentColor" stroke-width="1.6" /><circle cx="10" cy="8" r="2" fill="currentColor" /></svg>}
