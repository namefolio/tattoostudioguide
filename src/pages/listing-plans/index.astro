---
import Base from '../../layouts/Base.astro';
import Faqs from '../../components/Faqs.astro';
import { site } from '../../../site.config';
import { basicBullets, howToSteps, onSale, payLabel, payLink, plansFaqs, plansIntro, price, soonText, verifiedBullets } from '../../lib/copy';
import { faqPage } from '../../lib/jsonld';

const e = site.entity;
---
<Base
  title={`List your ${e.one}: Basic or Verified | ${site.name}`}
  description={`Every ${e.one} can have a free Basic listing. Verified (${onSale ? price : 'coming soon'}) adds a ${site.credential.name} check, owner confirmation and a place above Basic listings.`}
  path="/listing-plans/"
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Listing plans', url: '/listing-plans/' }]}
  jsonld={faqPage(plansFaqs)}
>
  <header class="page-head">
    <h1>List your {e.one}: Basic or Verified</h1>
    <p class="lead">{plansIntro}</p>
  </header>
  <div class="prose">

  <div class="plans">
    <section class="plan" aria-labelledby="plan-basic">
      <h2 id="plan-basic">Basic</h2>
      <p class="price">Free</p>
      <ul>{basicBullets.map((b) => <li>{b}</li>)}</ul>
    </section>
    <section class="plan is-verified" aria-labelledby="plan-verified">
      <h2 id="plan-verified">Verified</h2>
      <p class="price">{price}</p>
      <ul>{verifiedBullets.map((b) => <li>{b}</li>)}</ul>
    </section>
  </div>

  {onSale ? (
    <>
      <h2>How to get a Verified listing</h2>
      <ol>{howToSteps.map((s) => <li>{s}</li>)}</ol>

      <div class="btns">
        <a class="btn btn-primary" href="/add-your-business/?tier=verified">Send your {e.one}’s details</a>
        <a class="btn btn-secondary" href={payLink}>{payLabel}</a>
      </div>
    </>
  ) : (
    <>
      <h2>Verified is coming soon</h2>
      <p>{soonText}</p>

      <div class="btns">
        <a class="btn btn-primary" href="/add-your-business/">Add your {e.one} free</a>
      </div>
    </>
  )}

  <Faqs faqs={plansFaqs} />
  </div>
</Base>
