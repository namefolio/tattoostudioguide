---
import Base from '../../../layouts/Base.astro';
import Results from '../../../components/Results.astro';
import BestFor from '../../../components/BestFor.astro';
import { site } from '../../../../site.config';
import { regionPaths } from '../../../lib/pages';
import { itemList } from '../../../lib/jsonld';
import type { Region } from '../../../lib/core';

export const getStaticPaths = regionPaths;
const { region, intro, noindex } = Astro.props as { region: Region; intro: string; noindex: boolean };
const hubUrl = `/${site.hub}/`;
const u = site.ui;
---
<Base
  title={site.titles.region(region.name, region.listings.length)}
  description={site.titles.regionDescription(region.name, region.listings.length, region.cities.length)}
  path={region.url}
  noindex={noindex}
  bare
  crumbs={[{ name: 'Home', url: '/' }, { name: 'Cities', url: hubUrl }, { name: region.name, url: region.url }]}
  jsonld={[itemList(`${site.entity.Many} in ${region.name}`, region.listings)]}
>
  <div class="wrap">
    <header class="page-head">
      <span class="kicker">State</span>
      <h1>{site.entity.Many} in {region.name}</h1>
      <p class="lead">{intro}</p>
    </header>
    <section aria-labelledby="cities">
      <h2 id="cities" class="visually-hidden">Cities in {region.name}</h2>
      <ul class="city-list">
        {region.cities.map((c) => <li><a href={c.url}><span class="city">{c.name}</span><span class="meta">{c.listings.length} {c.listings.length === 1 ? u.one : u.many}</span></a></li>)}
      </ul>
    </section>
    <div class="section">
      <Results listings={region.listings} heading={`All ${u.many} in ${region.name}`} showCity />
    </div>
    <BestFor listings={region.listings} place={region.name} />
  </div>
</Base>
