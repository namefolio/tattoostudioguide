---
import Base from '../../layouts/Base.astro';
import SearchBox from '../../components/SearchBox.astro';
import { site } from '../../../site.config';
import { loadAll } from '../../lib/data';

export const getStaticPaths = () => [{ params: { hub: site.hub } }];
const { regions, listings } = await loadAll();
const u = site.ui;
const title = `${site.entity.ManyTitle} by City and ${site.regionNoun[0].toUpperCase()}${site.regionNoun.slice(1)} | ${site.name}`;
const nCities = regions.reduce((s, r) => s + r.cities.length, 0);
---
<Base title={title} description={`Browse ${listings.length} ${site.entity.many} in ${nCities} ${nCities === 1 ? 'city' : 'cities'} by ${site.regionNoun} and city.`} path={`/${site.hub}/`} noindex={listings.length < 3} crumbs={[{ name: 'Home', url: '/' }, { name: 'Cities', url: `/${site.hub}/` }]}>
  <header class="page-head">
    <span class="kicker">Explore</span>
    <h1>{u.Many} by city</h1>
    <p class="lead">{site.entity.Many} grouped by {site.regionNoun} and city. Each city page lists what its {u.many} publish: styles, walk-ins, minimums and hours.</p>
  </header>
  {regions.length === 0 ? (
    <div class="empty">
      <h2>{site.ui.launchTitle}</h2>
      <p>{site.ui.launchLead}</p>
      <div class="btns"><a class="btn btn-primary" href="/add-your-business/">Add a {u.one}</a></div>
    </div>
  ) : (
    regions.map((r) => (
      <section class="state-block" aria-labelledby={`st-${r.slug}`}>
        <h2 id={`st-${r.slug}`}><a href={r.url}>{r.name}</a></h2>
        <ul class="city-list">{r.cities.map((c) => <li><a href={c.url}><span class="city">{c.name}</span><span class="meta">{c.listings.length} {c.listings.length === 1 ? u.one : u.many}</span></a></li>)}</ul>
      </section>
    ))
  )}
  <section class="section" aria-labelledby="find">
    <h2 id="find">Looking for somewhere else?</h2>
    <SearchBox id="hub-q" />
  </section>
</Base>
