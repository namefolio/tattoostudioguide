---
import Base from '../../../layouts/Base.astro';
import Results from '../../../components/Results.astro';
import { site } from '../../../../site.config';
import { termPages, type TermPage } from '../../../lib/data';
import { itemList } from '../../../lib/jsonld';

export async function getStaticPaths() {
  return (await termPages()).map((page) => ({ params: { taxonomy: page.segment, term: page.term }, props: { page } }));
}
const { page } = Astro.props as { page: TermPage };
const isPrimary = page.segment === site.primaryTaxonomy;
const intro = isPrimary ? site.termIntros[page.term] : undefined;
const parent = isPrimary ? [{ name: site.ui.Terms, url: `/${site.primaryTaxonomy}/` }] : [];
---
<Base
  title={`${page.title} ${site.countryPhrase} | ${site.name}`}
  description={page.description}
  path={page.url}
  bare
  crumbs={[{ name: 'Home', url: '/' }, ...parent, { name: page.label, url: page.url }]}
  jsonld={[itemList(page.title, page.listings)]}
>
  <div class="wrap">
    <header class="page-head">
      <span class="kicker">{isPrimary ? site.ui.term : 'Category'}</span>
      <h1>{page.title}</h1>
      {intro && <p class="lead">{intro}</p>}
      <p class:list={[{ lead: !intro, muted: !!intro }]}>{page.description}</p>
    </header>
    <Results listings={page.listings} heading={`${site.ui.Many} listing ${page.label.toLowerCase()}`} showCity hideStyle={isPrimary} />
  </div>
</Base>
