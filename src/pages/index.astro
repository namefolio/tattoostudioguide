---
import Base from '../layouts/Base.astro';
import Faqs from '../components/Faqs.astro';
import ListingCard from '../components/ListingCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { site } from '../../site.config';
import { loadAll, termPages } from '../lib/data';
import { homeGraph, faqPage } from '../lib/jsonld';
import { disclosure, disclosureLinkText, ownerText, ownerTitle, whyPoints } from '../lib/copy';
import { primaryTerms, shortLabel, termHref } from '../lib/discovery';

const { listings, regions } = await loadAll();
const pageUrls = new Set((await termPages()).map((t) => t.url));
const faqs = site.homeFaqs;
const u = site.ui;
const launch = listings.length < u.launchThreshold;

const count = (term: string) => listings.filter((l) => primaryTerms(l).includes(term)).length;
const featured = site.featuredTerms.map((term) => ({ term, label: shortLabel(term), href: termHref(term, pageUrls), n: count(term), intro: site.termIntros[term] }));
// Hero shortcuts: the featured styles, then any filter shortcut that has listings (e.g. walk-ins).
const shortcutFilters = site.filters.filter((f) => f.key === 'walk-ins');

const cities = regions.flatMap((r) => r.cities.map((c) => ({ ...c, code: r.code }))).sort((a, b) => b.listings.length - a.listings.length || a.name.localeCompare(b.name));
const topCities = cities.slice(0, 12);
const studios = listings.slice(0, launch ? 6 : 8);
const nVerified = studios.filter((l) => l.effectiveTier === 'verified').length;
---
<Base title={site.titles.home} description={site.titles.homeDescription} path="/" banner bare jsonld={[...homeGraph(), ...faqPage(faqs)]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap">
      <h1 id="hero-title" class="hero-title">{u.heroTitle.map((line) => <span>{line}</span>)}</h1>
      <p class="lead">{u.heroLead}</p>
      <SearchBox id="hero-q" />
      <div class="shortcuts">
        <p class="shortcuts-label" id="popular">Popular {u.terms}</p>
        <ul class="chips" aria-labelledby="popular">
          {featured.map((s) => <li><a class="chip" href={s.href}>{s.label}</a></li>)}
          {shortcutFilters.map((f) => <li><a class="chip" href={pageUrls.has(`/services/${f.key}/`) ? `/services/${f.key}/` : `/studios/?f=${f.key}`}>{f.label}</a></li>)}
        </ul>
      </div>
    </div>
  </section>

  <div class="wrap">
    {launch && (
      <section class="section" aria-labelledby="launch-title">
        <div class="launch">
          <div>
            <span class="kicker">Now listing</span>
            <h2 id="launch-title">{u.launchTitle}</h2>
            <p class="lead">{u.launchLead}</p>
          </div>
          <div>
            <p>Know a {u.one} that belongs here?</p>
            <div class="btns"><a class="btn btn-primary" href="/add-your-business/">Add a {u.one}</a></div>
          </div>
        </div>
        {cities.length > 0 && (
          <div class="where">
            <p class="shortcuts-label" id="where">Listed so far</p>
            <ul class="chips" aria-labelledby="where">{cities.map((c) => <li><a class="chip" href={c.url}>{c.name}, {c.code}</a></li>)}</ul>
          </div>
        )}
      </section>
    )}

    <section class="section" aria-labelledby="by-style">
      <div class="section-head">
        <div>
          <span class="kicker">Explore</span>
          <h2 id="by-style">By {u.term}</h2>
        </div>
        <a class="more" href={`/${site.primaryTaxonomy}/`}>All {u.terms} →</a>
      </div>
      <ol class="style-index">
        {featured.map((s, i) => (
          <li>
            <a href={s.href}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <span class="name">{s.label}</span>
              <span class="arrow" aria-hidden="true">→</span>
              {s.intro && <span class="blurb">{s.intro}</span>}
              {s.n > 0 && <span class="count">{s.n} {s.n === 1 ? u.one : u.many}</span>}
            </a>
          </li>
        ))}
      </ol>
    </section>

    {!launch && topCities.length > 0 && (
      <section class="section" aria-labelledby="by-city">
        <div class="section-head">
          <div>
            <span class="kicker">Explore</span>
            <h2 id="by-city">By city</h2>
          </div>
          <a class="more" href={`/${site.hub}/`}>All cities →</a>
        </div>
        <ul class="city-list">
          {topCities.map((c) => (
            <li><a href={c.url}><span class="city">{c.name}</span><span class="meta">{c.code} · {c.listings.length} {c.listings.length === 1 ? u.one : u.many}</span></a></li>
          ))}
        </ul>
      </section>
    )}

    {studios.length > 0 && (
      <section class="section" aria-labelledby="studios">
        <div class="section-head">
          <div>
            <span class="kicker">{launch ? 'Recently added' : 'Directory'}</span>
            <h2 id="studios">{u.Many}</h2>
          </div>
          <a class="more" href="/studios/">All {u.many} →</a>
        </div>
        {nVerified > 0 && <p class="disclosure">{disclosure} <a href="/listing-plans/">{disclosureLinkText}</a></p>}
        <ul class="grid">{studios.map((l) => <ListingCard listing={l} showCity />)}</ul>
      </section>
    )}

    <section class="section" aria-labelledby="why">
      <div class="section-head">
        <div>
          <span class="kicker">Why {site.name}</span>
          <h2 id="why">A tattoo directory <em>without the noise.</em></h2>
        </div>
        <a class="more" href="/about/">About and sources →</a>
      </div>
      <ul class="why">
        {whyPoints.map((p, i) => (
          <li><span class="num">{String(i + 1).padStart(2, '0')}</span><h3>{p.title}</h3><p>{p.text}</p></li>
        ))}
      </ul>
    </section>
  </div>

  <section class="owner" aria-labelledby="owner">
    <div class="wrap">
      <div>
        <span class="kicker">For {u.many}</span>
        <h2 id="owner">{ownerTitle}</h2>
        <p>{ownerText}</p>
      </div>
      <div class="btns">
        <a class="btn btn-light" href="/add-your-business/">Add your {u.one} →</a>
        <a class="btn btn-secondary" href="/listing-plans/">Compare plans</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <Faqs faqs={faqs} class="section" />
  </div>
</Base>
